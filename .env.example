# OpenRouter LLM configuration for /assistant build command
# Copy this file to .env and fill in your values.
# Place in the server root (or run/ directory during development).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# TypeSafe System One for /assistant think (independent of OpenRouter)
TYPESAFE_API_KEY=your-api-key-here
TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
TYPESAFE_INTERVAL_MS=1000
TYPESAFE_TIMEOUT_MS=3000
TYPESAFE_MAX_AGE_MS=3000
TYPESAFE_MIN_CONFIDENCE=0.55
TYPESAFE_THREAT_THRESHOLD=0.65
TYPESAFE_SCAN_RADIUS=20
TYPESAFE_MAX_TARGETS=12
